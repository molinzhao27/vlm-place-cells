# Copy to host.env (gitignored) and fill in. Sourced by common.sh.
MI_VAST_HOST=user@gpu-host.example.com
MI_IMAGE=my-image:py312-cu132           # any image with Python 3.12 + CUDA torch
MI_BASE_PYTHON=/usr/bin/python3         # that image's Python, used to create the venv
MI_USER=root                            # user that runs jobs in the container
# MI_CC=/usr/bin/gcc                    # C compiler for Triton, if not on PATH
# MI_GPU_LOCK=/home/user/.gpu-0.lock    # lock file shared with other jobs on the GPU
# MI_GPU_TURN=/home/user/gpu-turn.sh    # waits for a project's turn in a shared GPU order (--turn)

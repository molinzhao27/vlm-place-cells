# Copy to host.env (gitignored) and fill in. Sourced by common.sh.
R4_HOST=user@4070-host                       # SSH target (key login; BatchMode)
R4_ROOT=/home/user/MechInterp                # project folder on the host (absolute)
R4_VGGT=/home/user/vggt                      # VGGT clone (absolute; setup.sh clones it)
# R4_PYTHON=python3                          # Python 3.12+ for the venv, if the host has no uv
# R4_TORCH_INDEX=https://download.pytorch.org/whl/cu132   # pick the CUDA build the host's driver supports
# R4_GPU_LOCK=/tmp/mechinterp-gpu.lock       # lock held by every GPU job run through run.sh

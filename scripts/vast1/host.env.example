# Copy to host.env (gitignored) and fill in. Sourced by common.sh. For a second host, copy to
# host-NAME.env (also gitignored) and run the scripts with MI_HOST=NAME.
MI_VAST_HOST=user@gpu-host.example.com
MI_IMAGE=my-image:py312-cu132           # any image with Python 3.12 + CUDA torch
MI_BASE_PYTHON=/usr/bin/python3         # that image's Python, used to create the venv
MI_USER=root                            # user that runs jobs in the container
# MI_CC=/usr/bin/gcc                    # C compiler for Triton, if not on PATH
# MI_GPU_LOCK=/home/user/.gpu-0.lock    # lock file shared with other jobs on the GPU (legacy gpu-run.sh)
# MI_GPU_TURN=/home/user/gpu-turn.sh    # waits for a project's turn in a shared GPU order (legacy --turn)
# container.sh start (defaults: CDI GPU flags, 48g memory, 16g shm, hostname vast1-mechinterp):
# MI_GPU_ARGS=(--device nvidia.com/gpu=all)
# MI_MEMORY=48g
# MI_SHM=16g
# MI_HOSTNAME=vast1-mechinterp
# MI_REQUIREMENTS=requirements.txt      # container.sh env; requirements-lock.txt on an image without torch

# A host without a torch image whose GPU works only through the nvidia runtime (vast-3):
# MI_IMAGE=mechinterp-base:py312        # built by container.sh image from scripts/vast1/Dockerfile
# MI_BASE_PYTHON=/usr/local/bin/python3.12
# MI_REQUIREMENTS=requirements-lock.txt
# MI_GPU_ARGS=(--runtime=nvidia -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=compute,utility)
# MI_MEMORY=24g
# MI_SHM=8g
# MI_HOSTNAME=vast3-mechinterp
